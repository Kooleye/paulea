# Скопируйте этот файл и назовите копию точно так:  .env
# Без этого файла всё работает, но заявки печатаются только в терминале.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда присылать заявки: id группы (с минусом) или ваш личный id
TELEGRAM_MANAGER_CHAT_ID=

# Адрес Telegram Bot API. Оставьте пустым — будет официальный api.telegram.org.
# Если хостинг не пускает к Telegram (как Timeweb App Platform), укажите свой
# прокси (Cloudflare Worker), например:  https://tg-proxy.ваш-логин.workers.dev
TELEGRAM_API_BASE=

# Пароль от админки (страница /admin.html)
ADMIN_PASSWORD=admin

# Порт, на котором работает сервер
PORT=3000

# true  — витрина работает и в обычном браузере (удобно для тестов)
# false — заявки принимаются только из Telegram (так нужно на боевом сервере)
ALLOW_BROWSER=true

# ---------------------------------------------------------------------------
# S3-хранилище (Timeweb S3) — чтобы фото и товары НЕ пропадали при пересборке.
# Если эти переменные пустые — всё работает по-старому, из локальных файлов.
# Бакет делайте ПРИВАТНЫМ (в базе телефоны клиентов).

# Адрес хранилища (у Timeweb обычно такой)
S3_ENDPOINT=https://s3.twcstorage.ru

# Регион (указан в панели хранилища, чаще всего ru-1)
S3_REGION=ru-1

# Имя бакета — скопируйте точно из панели (часто с префиксом, напр. abc12345-myshop)
S3_BUCKET=

# Ключи доступа к хранилищу (Access key / Secret key из панели)
S3_ACCESS_KEY=
S3_SECRET_KEY=
